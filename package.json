{
  "name": "basalt-db-studio",
  "version": "0.1.0",
  "description": "Lightweight, cross-platform database GUI (PostgreSQL, MySQL/MariaDB, SQLite)",
  "type": "module",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "svelte-check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "prepare": "git config core.hooksPath .githooks || true",
    "design-check": "node scripts/design-check.mjs",
    "design-check:self-test": "node scripts/design-check.selftest.mjs",
    "design-check:impeccable": "node scripts/impeccable-detect.mjs src",
    "check": "svelte-check --tsconfig ./tsconfig.json && vitest run && node scripts/design-check.mjs",
    "tauri": "tauri",
    "install:app": "node scripts/install.mjs",
    "rollback": "node scripts/install.mjs --rollback",
    "dist": "node scripts/install.mjs --dist"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.1",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@lezer/highlight": "^1.2.3",
    "@lucide/svelte": "^1.26.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "bits-ui": "^2.18.1",
    "sql-formatter": "^15.8.2"
  }
}
